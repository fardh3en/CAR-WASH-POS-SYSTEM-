rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Is user authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if current user has matching UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function: Is active Admin role
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN' && getUserData().isActive == true;
    }

    // Helper function: Is active staff or admin
    function isActiveUser() {
      return isAuthenticated() && getUserData().isActive == true;
    }

    // Users Collection Security Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && !(isOwner(userId) && request.resource.data.isActive == false)
        && !(isOwner(userId) && request.resource.data.role != 'ADMIN');
      allow delete: if false;
    }

    // Vehicle Categories Security Rules
    match /vehicleCategories/{categoryId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Vehicles Security Rules
    match /vehicles/{vehicleId} {
      allow read, create, update: if isActiveUser();
      allow delete: if false;
    }

    // Customers Security Rules
    match /customers/{customerId} {
      allow read, create, update: if isActiveUser();
      allow delete: if false;
    }

    // Service Packages Security Rules
    match /servicePackages/{packageId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Pricing Rules Security Rules
    match /pricingRules/{ruleId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    
    // Default deny for all other non-user collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
