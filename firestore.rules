rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Is user authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if current user has matching UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function: Is active Admin role
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN' && getUserData().isActive == true;
    }

    // Users Collection Security Rules
    match /users/{userId} {
      // 1. READ Rules: Authenticated users can read their own profile; Admin can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      
      // 2. CREATE Rules: Only active Admin can create user profiles
      allow create: if isAdmin();

      // 3. UPDATE Rules: Only active Admin can update profiles, subject to safety constraints:
      allow update: if isAdmin()
        // Safety constraint: Prevent an Admin from accidentally deactivating their own account
        && !(isOwner(userId) && request.resource.data.isActive == false)
        // Safety constraint: Prevent an Admin from accidentally demoting their own role
        && !(isOwner(userId) && request.resource.data.role != 'ADMIN');

      // 4. DELETE Rules: Hard deletions disallowed (must use soft delete via isActive = false by another Admin)
      allow delete: if false;
    }
    
    // Default deny for all other non-user collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
