rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Is user authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if current user has matching UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function: Is active Admin role
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN' && getUserData().isActive == true;
    }

    // Helper function: Is active staff or admin
    function isActiveUser() {
      return isAuthenticated() && getUserData().isActive == true;
    }

    // Users Collection Security Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && !(isOwner(userId) && request.resource.data.isActive == false)
        && !(isOwner(userId) && request.resource.data.role != 'ADMIN');
      allow delete: if false;
    }

    // Vehicle Categories Security Rules
    match /vehicleCategories/{categoryId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Vehicles Security Rules
    match /vehicles/{vehicleId} {
      allow read, create, update: if isActiveUser();
      allow delete: if false;
    }

    // Customers Security Rules
    match /customers/{customerId} {
      allow read, create, update: if isActiveUser();
      allow delete: if false;
    }

    // Service Packages Security Rules
    match /servicePackages/{packageId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Pricing Rules Security Rules
    match /pricingRules/{ruleId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Transaction Counters Security Rules (Atomic Increment Only)
    match /transactionCounters/{dateStr} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && request.resource.data.count == 1;
      allow update: if isActiveUser() && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Transactions Security Rules (Strict Field-Diff Protection for Cancellation & Payment Completion)
    match /transactions/{transactionId} {
      allow read, create: if isActiveUser();
      allow update: if isActiveUser() && (
        // Case 1: Cancellation (Phase 5)
        (resource.data.status == 'OPEN'
         && request.resource.data.status == 'CANCELLED'
         && request.resource.data.cancellationReason is string
         && request.resource.data.cancellationReason.size() > 0
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt']))
        ||
        // Case 2: Atomic Payment Completion (Phase 6)
        (resource.data.status == 'OPEN'
         && resource.data.paymentStatus == 'UNPAID'
         && request.resource.data.status == 'COMPLETED'
         && request.resource.data.paymentStatus == 'PAID'
         && request.resource.data.paidAmount == resource.data.pricingSnapshot.actualPrice
         && request.resource.data.paymentMethod in ['CASH', 'UPI']
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'paidAmount', 'paymentMethod', 'paidAt', 'updatedAt']))
        ||
        // Case 3: Admin Payment Reversal (Phase 6)
        (isAdmin()
         && resource.data.status == 'COMPLETED'
         && resource.data.paymentStatus == 'PAID'
         && request.resource.data.status == 'OPEN'
         && request.resource.data.paymentStatus == 'UNPAID'
         && request.resource.data.paidAmount == 0
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'paidAmount', 'paymentMethod', 'paidAt', 'updatedAt']))
      );
      allow delete: if false;
    }

    // Payments Collection Security Rules (Phase 6 Audit Log)
    match /payments/{paymentId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && request.resource.data.amount > 0 && request.resource.data.paymentMethod in ['CASH', 'UPI'];
      allow update: if isAdmin()
        && resource.data.isReversed != true
        && request.resource.data.isReversed == true
        && request.resource.data.reversalReason is string
        && request.resource.data.reversalReason.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReversed', 'reversedAt', 'reversedByAdminId', 'reversalReason']);
      allow delete: if false;
    }
    
    // Default deny for all other non-user collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
