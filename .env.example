# Mr. Wash POS - Firebase Configuration Template
# Choose exactly one active backend per app build. Firebase remains available
# as a fallback while the Supabase backend is rolled out.
VITE_BACKEND_PROVIDER=firebase

# Supabase (select with VITE_BACKEND_PROVIDER=supabase)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase (select with VITE_BACKEND_PROVIDER=firebase)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
